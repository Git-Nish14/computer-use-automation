# Copy this to .env and fill in your values
OPENAI_API_KEY=sk-...

# Model to use for discovery (gpt-4o recommended for vision + tool use)
OPENAI_MODEL=gpt-4o

# Mock app settings (used by demo/mock_app/app.py)
MOCK_APP_HOST=127.0.0.1
MOCK_APP_PORT=5000

# Browser settings
BROWSER_HEADLESS=false
# Remote debugging port for human-in-the-loop handoff
BROWSER_CDP_PORT=9222
